{
  "name": "pizarra-deportiva",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_EXTRA_CA_CERTS=./.certs/corporate-root-ca.pem next dev --turbopack",
    "export": "next export",
    "build": "cross-env NODE_EXTRA_CA_CERTS=./.certs/corporate-root-ca.pem next build",
    "start": "cross-env NODE_EXTRA_CA_CERTS=./.certs/corporate-root-ca.pem next start",
    "lint": "next lint",
    "biome-write": "npx @biomejs/biome format --write .",
    "cert:export": "mkdir -p .certs && security find-certificate -a -c Zscaler -p /Library/Keychains/System.keychain > .certs/corporate-root-ca.pem"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.47.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "konva": "^9.3.16",
    "lucide-react": "^1.32.0",
    "next": "^16.2.3",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-konva": "^19.2.5",
    "sass": "^1.77.6",
    "shadcn": "^4.18.0",
    "sharp": "^0.33.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "20.17.23",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2",
    "cross-env": "^10.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "5.8.2"
  },
  "overrides": {
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2"
  }
}
